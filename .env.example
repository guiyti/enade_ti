# ==========================================
# Configurações do Supabase (Banco de Dados e Sincronização)
# ==========================================
# Cole abaixo a URL do Projeto e a Anon Key pública encontradas no painel do Supabase:
# Project Settings -> API -> Project URL & Project API Keys (anon/public)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# (Opcional) Service Role Key para operações de CLI / scripts administrativos
SUPABASE_SERVICE_ROLE_KEY=

# ==========================================
# Senhas de Autorização Segregadas
# ==========================================
# Senha solicitada APENAS ao sinalizar problemas em questões
NEXT_PUBLIC_FLAG_ACCESS_CODE=

# Senha solicitada APENAS ao auditor para limpar/resolver sinalizações
NEXT_PUBLIC_ADMIN_ACCESS_CODE=

# ==========================================
# Configurações do Sistema & OCR (Engine Local)
# ==========================================
LOG_LEVEL=INFO
DEBUG=false
TESSERACT_LANG=por+eng
PDF_DPI=300